# URL de conexão do Postgres (Render fornece isso automaticamente no painel do banco)
DATABASE_URL=postgres://usuario:senha@host:5432/nomedobanco

# Segredo usado para assinar o cookie de sessão do admin (troque por um valor aleatório longo)
SESSION_SECRET=troque-isso-por-um-texto-aleatorio-bem-grande

# Porta local (o Render define isso sozinho em produção)
PORT=3000

# Usados apenas pelo script scripts/create-admin.js para criar o primeiro usuário admin
ADMIN_USERNAME=igor
ADMIN_PASSWORD=escolha-uma-senha-forte
