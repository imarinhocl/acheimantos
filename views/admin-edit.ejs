<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Editar anúncio — Acheimantos</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="/admin" class="wordmark">achei<span>mantos</span></a>
  </div>
</header>

<main class="wrap admin-main">
  <section class="glass admin-panel">
    <h2>Editar anúncio</h2>
    <form method="POST" action="/admin/products/<%= product.id %>/edit" class="product-form">
      <div class="form-row">
        <label for="name">Nome da camisa</label>
        <input type="text" id="name" name="name" required value="<%= product.name %>">
      </div>
      <div class="form-row">
        <label for="team">Time</label>
        <input type="text" id="team" name="team" value="<%= product.team || '' %>">
      </div>
      <div class="form-row">
        <label for="platform">Plataforma</label>
        <select id="platform" name="platform" required>
          <option value="mercadolivre" <%= product.platform === 'mercadolivre' ? 'selected' : '' %>>Mercado Livre</option>
          <option value="shopee" <%= product.platform === 'shopee' ? 'selected' : '' %>>Shopee</option>
        </select>
      </div>
      <div class="form-row">
        <label for="affiliate_url">Link de afiliado</label>
        <input type="url" id="affiliate_url" name="affiliate_url" required value="<%= product.affiliate_url %>">
      </div>
      <div class="form-row">
        <label for="image_url">URL da imagem</label>
        <input type="url" id="image_url" name="image_url" required value="<%= product.image_url %>">
      </div>
      <div class="form-row">
        <label for="price">Preço (opcional, só exibição)</label>
        <input type="number" step="0.01" id="price" name="price" value="<%= product.price || '' %>">
      </div>
      <div class="edit-actions">
        <button type="submit">Salvar alterações</button>
        <a class="cancel-link" href="/admin">Cancelar</a>
      </div>
    </form>
  </section>
</main>
</body>
</html>